{
  "name": "VITRINE",
  "settings": [
    {
      "type": "paragraph",
      "content": "Product card effect by VITRINE (Paper Shaders). The photo stays the content; the effect is a layer that gives way on hover, tap or focus. Glass is the v0.2 default; dither and halftone are the print looks of v0.1."
    },
    {
      "type": "checkbox",
      "id": "vitrine_cards_enabled",
      "label": "Effect on product cards",
      "default": true
    },
    {
      "type": "select",
      "id": "vitrine_card_effect",
      "label": "Effect",
      "options": [
        {
          "value": "glass",
          "label": "Glass (shop window)"
        },
        {
          "value": "dither",
          "label": "Dither (newsprint)"
        },
        {
          "value": "halftone",
          "label": "Halftone (CMYK / riso)"
        }
      ],
      "default": "glass"
    },
    {
      "type": "select",
      "id": "vitrine_card_preset",
      "label": "Preset",
      "info": "glass: window; dither: newsprint / default; halftone: riso / default. A preset of another effect falls back to that effect's own.",
      "options": [
        {
          "value": "window",
          "label": "Window (glass)"
        },
        {
          "value": "newsprint",
          "label": "Newsprint (dither)"
        },
        {
          "value": "riso",
          "label": "Riso (halftone)"
        },
        {
          "value": "default",
          "label": "Paper Shaders default"
        }
      ],
      "default": "window"
    },
    {
      "type": "checkbox",
      "id": "vitrine_card_reveal",
      "label": "Reveal the photo on hover / tap / focus (glass: the pane slides away)",
      "default": true
    }
  ]
}
