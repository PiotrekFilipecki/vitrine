{
  "name": "vitrine-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "description": "VITRINE: Paper Shaders for Shopify themes and headless storefronts (monorepo root)",
  "license": "Apache-2.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --filter \"./packages/*\" run typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "serve": "node scripts/serve.mjs 4173"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@paper-design/shaders": "0.0.82",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
