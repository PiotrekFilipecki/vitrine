# Optional. Without these the demo runs on the photographs and catalogue from the repo (examples/fixtures) and says so
# in the footer. Public Storefront API token only (Headless channel → Storefront API → public access token), never an
# Admin token. Pre-order products read their release date from the custom.release_date metafield (ADR-0003).
SHOPIFY_STORE_DOMAIN=niwwts.myshopify.com
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
SHOPIFY_API_VERSION=2026-10
