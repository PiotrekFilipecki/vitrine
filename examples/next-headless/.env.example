# Optional. Without these the demo runs on the NIWWTS fixtures from the repo and says so in the footer.
# Public Storefront API token only (Headless channel → Storefront API → public access token). Never an Admin token.
SHOPIFY_STORE_DOMAIN=niwwts.myshopify.com
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
SHOPIFY_API_VERSION=2026-10
